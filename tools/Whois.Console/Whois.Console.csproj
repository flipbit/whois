<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Whois.Console</AssemblyName>
    <RootNamespace>Whois</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-whois</ToolCommandName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.0.1-alpha1</Version>
    <PackageId>dotnet-whois</PackageId>
    <Authors>Chris Wood</Authors>
    <Company>flipbit.co.uk</Company>
    <Product>.NET WHOIS Lookup</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Whois\Whois.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>


</Project>
