    "whois.iana.org": {
      // IANA WHOIS is the authoritative server only for .arpa and .int TLDs.
      // Queries for "be" and "com" route via IANA to whois.dns.be/whois.verisign-grs.com
      // and return non-Found statuses (NOT ALLOWED / No match). Those entries are removed.
      // u34jedzcq.arpa/.int return "This query returned 0 objects." but template hint
      // doesn't match because response lines start with '%'. Removed until template fixed.
      "tld": "tld",
