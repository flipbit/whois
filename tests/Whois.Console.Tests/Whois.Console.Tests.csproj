<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Whois</RootNamespace>
    <!-- MA0053: Test classes don't need to be sealed -->
    <!-- MA0004: ConfigureAwait is not relevant in test code -->
    <!-- MA0026: TODO comments are allowed in tests -->
    <!-- MA0003: Named parameters are optional in test assertions -->
    <!-- IDE0130: Namespace does not match folder structure (test namespaces use logical grouping) -->
    <NoWarn>$(NoWarn);MA0053;MA0004;MA0026;MA0003;IDE0130</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Spectre.Console.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Whois.Console\Whois.Console.csproj" />
  </ItemGroup>
</Project>
