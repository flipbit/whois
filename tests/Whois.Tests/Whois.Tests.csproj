<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Whois</RootNamespace>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <!-- Suppress xUnit analyzer style rules that fire as errors via TreatWarningsAsErrors -->
    <!-- Suppress nullable warnings in test files — we don't annotate ~200 parsing test classes -->
    <!-- Suppress naming convention for test fields — parser fields use camelCase without _ prefix -->
    <!-- Suppress namespace-folder match — test namespaces use PascalCase but folders contain dots (e.g. whois.nic.uk) -->
    <NoWarn>$(NoWarn);xUnit2004;xUnit2013;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8767;CS8769;IDE1006;IDE0130;MA0053;MA0004;MA0026;MA0144;MA0182;MA0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Whois\Whois.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>