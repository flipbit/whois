<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Whois.Console</AssemblyName>
    <RootNamespace>Whois</RootNamespace>
    <!-- Suppress MA0004 (ConfigureAwait): top-level application code; no synchronization context concerns -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-whois</ToolCommandName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>0.0.1-alpha1</Version>
    <PackageId>dotnet-whois</PackageId>
    <Authors>Chris Wood</Authors>
    <Company>flipbit.co.uk</Company>
    <Product>.NET WHOIS Lookup</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whois\Whois.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whois.Console.Tests" />
  </ItemGroup>

</Project>
