<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Whois.Console</AssemblyName>
    <RootNamespace>Whois</RootNamespace>
    <!-- Suppress MA0004 (ConfigureAwait): top-level application code; no synchronization context concerns -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-whois</ToolCommandName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>dotnet-whois</PackageId>
    <Description>A cross-platform .NET tool for querying WHOIS and RDAP domain registration data</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whois\Whois.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whois.Console.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\Whois\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
